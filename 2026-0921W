  ]}, options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{position:"bottom",labels:{boxWidth:12,font:{size:11}}}, title:{display:true,text:"트래픽 매체 CPC 비교(₩)",font:{size:12}}}, scales:{y:{ticks:{callback:v=>"₩"+v,font:{size:10}}}} } });
}
function renderPromoTags(){
  document.getElementById("promoTags").innerHTML = DATA.promotions.map(p=> `<span class="promo-tag"><b>${p.date}</b> ${p.label}</span>`).join("");
}
const CONV_GROUP_ORDER = [ "MY|Meta", "SG|Meta", "MY|TikTok GMV Max", "MY|Shopee Ads", "SG|Shopee Ads", "MY|Google", "SG|Google" ];
const TRAFFIC_GROUP_ORDER = [ "MY|Meta (BR)", "SG|Meta (BR)", "MY|TikTok" ];
function groupSort(list, order){
  const groups = {}; order.forEach(k=>groups[k]=[]);
  list.forEach(item=>{ const key = item.country+"|"+item.channel; if(!groups[key]) groups[key] = []; groups[key].push(item); });
  order.forEach(k=> groups[k].sort((a,b)=> b.spend - a.spend));
  return order.filter(k=>groups[k] && groups[k].length).map(k=>({key:k, items:groups[k]}));
}
const GROUP_LABEL = { "MY|Meta":"말레이시아 · Meta (전환)", "SG|Meta":"싱가포르 · Meta (전환)", "MY|TikTok GMV Max":"말레이시아 · TikTok GMV Max (전환)", "MY|Shopee Ads":"말레이시아 · Shopee Ads (전환)", "SG|Shopee Ads":"싱가포르 · Shopee Ads (전환)", "MY|Google":"말레이시아 · Google (전환)", "SG|Google":"싱가포르 · Google (전환)", "MY|Meta (BR)":"말레이시아 · Meta BR (트래픽)", "SG|Meta (BR)":"싱가포르 · Meta BR (트래픽)", "MY|TikTok":"말레이시아 · TikTok (트래픽)" };
const GROUP_TO_MEDIA = { "MY|Meta":"Meta", "SG|Meta":"Meta", "MY|TikTok GMV Max":"TikTok", "MY|Shopee Ads":"Shopee Ads", "SG|Shopee Ads":"Shopee Ads", "MY|Google":"Google", "SG|Google":"Google", "MY|Meta (BR)":"Meta", "SG|Meta (BR)":"Meta", "MY|TikTok":"TikTok" };
function getGroupSummary(key, sub){
  const country = key.split("|")[0];
  const media = GROUP_TO_MEDIA[key];
  const entry = DATA.countryMedia.find(m=>m.country===country && m.media===media);
  return entry ? entry[sub] : null;
}
function rowStatusCell(spend, spendPrev, diffBadgeHtml){
  if(spend === 0) return `<span class="off-tag">OFF</span>`;
  if(spendPrev === 0) return `<span class="new-tag">NEW</span>`;
  return diffBadgeHtml;
}
function rowStatusClass(spend, spendPrev){
  if(spend === 0) return "row-off";
  if(spendPrev === 0) return "row-new";
  return "";
}
function renderCampaignTables(){
  document.getElementById("convCount").textContent = DATA.campaignsConv.length;
  document.getElementById("trafficCount").textContent = DATA.campaignsTraffic.length;
  const convGroups = groupSort(DATA.campaignsConv, CONV_GROUP_ORDER);
  const convWrap = document.getElementById("convTableWrap");
  convWrap.innerHTML = `<table> <thead><tr><th>캠페인명</th><th>국가/매체</th><th>지출</th><th>매출</th><th>ROAS(금주)</th><th>ROAS(전주)</th><th>증감</th></tr></thead> <tbody>${convGroups.map(g=>{
    const sum = getGroupSummary(g.key, "conv");
    const summaryRow = sum ? (()=>{ const diff = pctChange(sum.roas, sum.roasPrev); return `<tr class="row-summary"> <td colspan="2">${GROUP_LABEL[g.key]} 요약 (${g.items.length}개 캠페인 합계)</td> <td>${fmtWon(sum.spend)}</td> <td>${fmtWon(sum.revenue)}</td> <td>${sum.roas}%</td> <td>${sum.roasPrev}%</td> <td>${numSpan(diff, true)}</td> </tr>`; })() : `<tr><td colspan="7" style="background:var(--gray-100);font-weight:800;color:var(--navy-2);text-align:left;">${GROUP_LABEL[g.key]} · ${g.items.length}개</td></tr>`;
    const groupId = g.key.replace(/[^A-Za-z0-9]/g,'_');
    const toggleRow = `<tr class="grp-toggle-row"><td colspan="7"> <button class="grp-toggle-btn" data-group="${groupId}"><span class="arrow">▸</span> 상세 캠페인별 증감률 보기 (${g.items.length}개)</button> </td></tr>`;
    const comparable = g.items.filter(c=> c.spend>0 && c.spendPrev>0);
    const diffs = comparable.map(c=> pctChange(c.roasThis, c.roasPrev));
    const maxDiff = diffs.length ? Math.max(...diffs) : null;
    const minDiff = diffs.length ? Math.min(...diffs) : null;
    const bestName = (maxDiff!==null && maxDiff>0) ? comparable[diffs.indexOf(maxDiff)].name : null;
    const worstName = (minDiff!==null && minDiff<0) ? comparable[diffs.indexOf(minDiff)].name : null;
    const rows = g.items.map(c=>{
      const diff = pctChange(c.roasThis, c.roasPrev);
      let deltaCell = rowStatusCell(c.spend, c.spendPrev, numSpan(diff, true));
      const statusClass = rowStatusClass(c.spend, c.spendPrev);
      if(statusClass===""){ if(bestName && c.name===bestName && diff===maxDiff) deltaCell = `<span class="delta-best">${numSpan(diff, true)}</span>`; else if(worstName && c.name===worstName && diff===minDiff) deltaCell = `<span class="delta-worst">${numSpan(diff, true)}</span>`; }
      return `<tr class="grp-detail grp-${groupId} ${statusClass}"> <td>${c.name}</td> <td><span class="ctry-chip ${c.country.toLowerCase()}">${c.country}</span> ${c.channel}</td> <td>${fmtWon(c.spend)}</td> <td>${fmtWon(c.revenue)}</td> <td><b>${c.roasThis}%</b></td> <td>${c.roasPrev}%</td> <td>${deltaCell}</td> </tr>`;
    }).join("");
    return summaryRow + toggleRow + rows;
  }).join("")}</tbody> </table>`;
  convWrap.querySelectorAll(".grp-toggle-btn").forEach(btn=>{ btn.addEventListener("click", ()=>{ const gid = btn.dataset.group; const open = btn.classList.toggle("open"); convWrap.querySelectorAll(".grp-"+gid).forEach(tr=> tr.classList.toggle("open", open)); btn.innerHTML = open ? `<span class="arrow">▸</span> 상세 캠페인별 증감률 숨기기` : `<span class="arrow">▸</span> 상세 캠페인별 증감률 보기 (${convWrap.querySelectorAll(".grp-"+gid).length}개)`; }); });
  const trafficGroups = groupSort(DATA.campaignsTraffic, TRAFFIC_GROUP_ORDER);
  const trafficWrap = document.getElementById("trafficTableWrap");
  trafficWrap.innerHTML = `<table> <thead><tr><th>캠페인명</th><th>국가/매체</th><th>지출</th><th>클릭수</th><th>CPC(금주)</th><th>CPC(전주)</th><th>증감</th></tr></thead> <tbody>${trafficGroups.map(g=>{
    const rows = g.items.map(c=>{ const diff = pctChange(c.cpcThis, c.cpcPrev); const deltaCell = rowStatusCell(c.spend, c.spendPrev, numSpan(diff, false)); const statusClass = rowStatusClass(c.spend, c.spendPrev); return `<tr class="${statusClass}"> <td>${c.name}</td> <td><span class="ctry-chip ${c.country.toLowerCase()}">${c.country}</span> ${c.channel}</td> <td>${fmtWon(c.spend)}</td> <td>${fmtNum(c.clicks)}</td> <td><b>${fmtWon(c.cpcThis)}</b></td> <td>${fmtWon(c.cpcPrev)}</td> <td>${deltaCell}</td> </tr>`; }).join("");
    return `<tr><td colspan="7" style="background:var(--gray-100);font-weight:800;color:var(--navy-2);text-align:left;">${GROUP_LABEL[g.key]} · ${g.items.length}개</td></tr>${rows}`;
  }).join("")}</tbody> </table>`;
}
function renderGallery(filter="ALL"){
  const grid = document.getElementById("galleryGrid");
  const items = DATA.gallery.filter(g => filter==="ALL" || g.country===filter || g.rank.includes(filter));
  grid.innerHTML = items.map(g=>{
    const isBest = g.rank.startsWith("BEST");
    const isMeta = g.channel.includes('Meta');
    const useCapture = g.img && isMeta;
    const thumbStyle = (g.img && !useCapture) ? ` style="background-image:url('${g.img}');background-size:cover;background-position:top center;"` : '';
    const shapeClass = useCapture ? 'thumb-capture' : (isMeta ? 'thumb-square' : (g.channel.includes('TikTok') ? 'thumb-vertical' : ''));
    const thumbInner = useCapture ? `<img class="capture-img" src="${g.img}" alt="${g.title}">` : '';
    return `<div class="g-card"> <div class="g-thumb ${shapeClass} ${g.img ? '' : g.type}"${thumbStyle}> <span class="g-rank ${isBest?'best':'worst'}">${g.rank}</span> ${thumbInner} ${g.img ? '' : `<small>${g.type==='video'?'영상':'이미지'} 소재(자리표시)</small>`} </div> <div class="g-body"> <div class="g-title">${g.title}</div> <div class="g-meta"><span class="ctry-chip ${g.country.toLowerCase()}">${g.country}</span><span>${g.channel}</span></div> <div class="g-metric" style="color:${g.tagClass==='good'?'var(--good)':'var(--bad)'}">${g.metric}</div> ${g.criteria ? `<div class="g-criteria">${g.criteria}</div>` : ''} ${g.url ? `<a class="g-preview-btn" href="${g.url}" target="_blank" rel="noopener">소재 미리보기 ↗</a>` : ''} </div> </div>`;
  }).join("");
}
function renderGalleryFilter(){
  const opts = ["ALL","MY","SG","BEST","WORST"];
  const labels = {ALL:"전체", MY:"말레이시아", SG:"싱가포르", BEST:"Best만", WORST:"Worst만"};
  const el = document.getElementById("galleryFilter");
  el.innerHTML = opts.map((o,i)=>`<button class="${i===0?'active':''}" data-f="${o}">${labels[o]}</button>`).join("");
  el.querySelectorAll("button").forEach(b=>{ b.addEventListener("click", ()=>{ el.querySelectorAll("button").forEach(x=>x.classList.remove("active")); b.classList.add("active"); renderGallery(b.dataset.f); }); });
}
function renderInsightNotes(){
  const el = document.getElementById("insightNotesWrap");
  if(!el || !DATA.insightNotes) return;
  el.innerHTML = DATA.insightNotes.map(n=>{
    const factsHtml = `<ul class="note-fact">${n.facts.map(f=>`<li>${f}</li>`).join("")}</ul>`;
    const todoHtml = `<ol>${(n.nextTodo||[]).map(t=>`<li>${t}</li>`).join("")}</ol>`;
    if(n.reviewed){
      return `<div class="note-card"> <div class="note-title">${n.title}</div> <div class="note-block"> <div class="note-label">사실 (1차 데이터)</div> ${factsHtml} </div> <div class="note-block"> <div class="note-label">원인 분석</div> <p style="font-size:12.5px;line-height:1.7;margin:0;">${n.analysis}</p> </div> <div class="note-block"> <div class="note-label">Next To-Do</div> <div style="font-size:12.5px;line-height:1.75;">${todoHtml}</div> </div> </div>`;
    }
    return `<div class="note-card"> <div class="note-title">${n.title}</div> <div class="note-block"> <div class="note-label">사실 (1차 데이터)</div> ${factsHtml} </div> <div class="note-block"> <div class="note-label"><span class="draft-tag">AI 초안 · 검토 필요</span> 원인 분석</div> <div class="draft-box"><p>${n.analysis}</p></div> </div> <div class="note-block"> <div class="note-label"><span class="draft-tag">AI 초안 · 검토 필요</span> Next To-Do</div> <div class="draft-box">${todoHtml}</div> </div> </div>`;
  }).join("");
}
function renderAccordion(){
  const el = document.getElementById("accordionWrap");
  el.innerHTML = Object.entries(DATA.countries).map(([code, d], idx)=>{
    const label = code==='MY' ? '말레이시아' : '싱가포르';
    return `<div class="acc ${idx===0?'open':''}"> <div class="acc-head" data-acc="${code}"><span><span class="ctry-chip ${code.toLowerCase()}">${code}</span> ${label} 전체 캠페인 (${d.campaignsConv.length + d.campaignsTraffic.length}개)</span><span class="arrow">▸</span></div> <div class="acc-body"> <h3 style="font-size:12.5px;margin:4px 0 8px;color:var(--gray-700);">전환 캠페인 (ROAS 우선) · ${d.campaignsConv.length}개</h3> <div class="table-scroll"><table> <thead><tr><th>캠페인명</th><th>매체</th><th>지출</th><th>매출</th><th>ROAS(금주)</th><th>ROAS(전주)</th></tr></thead> <tbody>${d.campaignsConv.map(c=>`<tr><td>${c.name}</td><td>${c.channel}</td><td>${fmtWon(c.spend)}</td><td>${fmtWon(c.revenue)}</td><td>${c.roasThis}%</td><td>${c.roasPrev}%</td></tr>`).join("")}</tbody> </table></div> <h3 style="font-size:12.5px;margin:16px 0 8px;color:var(--gray-700);">트래픽 캠페인 (CPC 우선) · ${d.campaignsTraffic.length}개</h3> <div class="table-scroll"><table> <thead><tr><th>캠페인명</th><th>매체</th><th>지출</th><th>클릭</th><th>CPC(금주)</th><th>CPC(전주)</th></tr></thead> <tbody>${d.campaignsTraffic.map(c=>`<tr><td>${c.name}</td><td>${c.channel}</td><td>${fmtWon(c.spend)}</td><td>${fmtNum(c.clicks)}</td><td>${fmtWon(c.cpcThis)}</td><td>${fmtWon(c.cpcPrev)}</td></tr>`).join("")}</tbody> </table></div> <div class="note-box">상품(SKU)별·인플루언서별 실적 데이터는 이번 raw data(mint/shopee 탭)에 없어 제외했습니다. 별도 소스가 있으면 알려주세요.</div> </div> </div>`;
  }).join("");
  el.querySelectorAll(".acc-head").forEach(h=>{ h.addEventListener("click", ()=> h.closest(".acc").classList.toggle("open")); });
}
document.querySelectorAll(".tab-btn").forEach(btn=>{ btn.addEventListener("click", ()=>{ document.querySelectorAll(".tab-btn").forEach(b=>b.classList.remove("active")); btn.classList.add("active"); document.querySelectorAll(".tabpanel").forEach(p=>p.classList.remove("active")); document.getElementById("tab-"+btn.dataset.tab).classList.add("active"); if(btn.dataset.tab === "trend"){ renderTrendChart(); renderChannelCharts(); } }); });
document.querySelectorAll(".sub-btn").forEach(btn=>{ btn.addEventListener("click", ()=>{ document.querySelectorAll(".sub-btn").forEach(b=>b.classList.remove("active")); btn.classList.add("active"); document.getElementById("convSection").style.display = btn.dataset.sub==="conv" ? "" : "none"; document.getElementById("trafficTableWrap").style.display = btn.dataset.sub==="traffic" ? "" : "none"; }); });
renderTitle(); renderKpi(); renderInsights(); renderCountryChannelGrid(); renderPromoTags(); renderCampaignTables(); renderGalleryFilter(); renderGallery(); renderInsightNotes(); renderAccordion(); renderTrendChart(); renderChannelCharts();

