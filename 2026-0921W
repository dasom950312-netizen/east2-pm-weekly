function promoBandToIdxRange(band){
  const dates = DATA.daily.dates;
  let startIdx = dates.findIndex(d => d >= band.start);
  if(startIdx === -1) return null;
  let endIdx = -1;
  for(let i=dates.length-1;i>=0;i--){ if(dates[i] <= band.end){ endIdx = i; break; } }
  if(endIdx === -1) return null;
  if(startIdx > endIdx) return null;
  return {startIdx, endIdx};
}
const PROMO_ROW_H = 20, PROMO_ROW_GAP = 3, PROMO_TOP_PAD = 8;
const promoBandsPlugin = {
  id: "promoBandsPlugin",
  beforeDatasetsDraw(chart){
    const bands = (chart.options.plugins.promoBandsPlugin || {}).bands || [];
    if(!bands.length) return;
    const {ctx, chartArea, scales} = chart;
    const xScale = scales.x;
    if(!chartArea) return;
    const step = xScale.getPixelForValue(1) - xScale.getPixelForValue(0);
    const halfStep = (isFinite(step) ? Math.abs(step) : 40) / 2;
    ctx.save();
    let rowIdx = 0;
    bands.forEach((b)=>{
      const range = promoBandToIdxRange(b);
      if(!range) return;
      const xStart = xScale.getPixelForValue(range.startIdx) - halfStep;
      const xEnd = xScale.getPixelForValue(range.endIdx) + halfStep;
      const y = chartArea.top + PROMO_TOP_PAD + rowIdx * (PROMO_ROW_H + PROMO_ROW_GAP);
      const w = Math.max(2, xEnd - xStart);
      ctx.fillStyle = b.bg;
      ctx.fillRect(xStart, y, w, PROMO_ROW_H);
      ctx.font = "600 10.5px -apple-system,sans-serif";
      ctx.fillStyle = b.text;
      ctx.textBaseline = "middle";
      const label = b.label;
      const textW = ctx.measureText(label).width;
      if(textW + 10 <= w){ ctx.textAlign = "center"; ctx.fillText(label, xStart + w/2, y + PROMO_ROW_H/2 + 0.5); }
      rowIdx++;
    });
    ctx.restore();
  }
};
Chart.register(promoBandsPlugin);
