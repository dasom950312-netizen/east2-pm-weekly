const pctChange = (cur, prev) => prev ? ((cur - prev) / prev * 100) : (cur? 100:0);
function deltaBadge(diff, higherIsBetter=true){
  const good = higherIsBetter ? diff >= 0 : diff <= 0;
  const cls = diff === 0 ? "flat" : (good ? "up" : "down");
  const arrow = diff === 0 ? "→" : (diff > 0 ? "▲" : "▼");
  return `<span class="delta ${cls}">${arrow} ${Math.abs(diff).toFixed(1)}%</span>`;
}
function numSpan(diff, higherIsBetter=true){
  const good = higherIsBetter ? diff >= 0 : diff <= 0;
  const cls = diff === 0 ? "" : (good ? "num-up" : "num-down");
  const arrow = diff === 0 ? "" : (diff > 0 ? "▲" : "▼");
  return `<span class="${cls}">${arrow} ${Math.abs(diff).toFixed(1)}%</span>`;
}
